# Copy this file to .env and fill in the values.
# RunPod API key: https://console.runpod.io/user/settings
RUNPOD_API_KEY=
# vast.ai API key (provider = "vast"): https://cloud.vast.ai/manage-keys/
VAST_API_KEY=
# Hugging Face token: TRELLIS.2 loads gated models (DINOv3, RMBG-2.0); accept their terms with this account first
HF_TOKEN=
